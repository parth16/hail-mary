# LLM provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HAILMARY_LLM_PROVIDER=openai
HAILMARY_MODEL=
HAILMARY_MOCK_LLM=true

# Local behavior
HAILMARY_DATA_DIR=./data
HAILMARY_LOCAL_ONLY=true
HAILMARY_LOG_LEVEL=INFO
HAILMARY_CALCULATED_RISK_MODE=true

# Portfolio defaults
HAILMARY_CAPITAL_BUDGET=100000
HAILMARY_MIN_CHECK=1000
HAILMARY_MAX_CHECK=10000

# Meridian / AngelList
HAILMARY_MERIDIAN_PROFILE_DIR=./data/browser-profiles/meridian
HAILMARY_MERIDIAN_START_URL=

# Optional web research
HAILMARY_ENABLE_WEB_RESEARCH=false

# Optional future data adapters
HAILMARY_ENABLED_PAID_PROVIDERS=
CRUNCHBASE_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
NEWSAPI_KEY=
SIMILARWEB_API_KEY=
SENSOR_TOWER_API_KEY=
PITCHBOOK_API_KEY=
CB_INSIGHTS_API_KEY=
